<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pencil rotated -45 degrees, drawn top-to-bottom in local coordinates. -->
    <group
        android:name="pencil"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">

        <!-- Eraser (pink/red) -->
        <path
            android:fillColor="#E63946"
            android:pathData="M40,20 h28 v10 h-28 z"/>

        <!-- Metal ferrule -->
        <path
            android:fillColor="#B0B0B0"
            android:pathData="M40,30 h28 v6 h-28 z"/>

        <!-- Ferrule ridges -->
        <path
            android:fillColor="#8A8A8A"
            android:pathData="M40,33 h28 v1 h-28 z"/>

        <!-- Pencil body (yellow) -->
        <path
            android:fillColor="#FFC94A"
            android:pathData="M40,36 h28 v40 h-28 z"/>

        <!-- Pencil body shadow stripe -->
        <path
            android:fillColor="#E5A82F"
            android:pathData="M60,36 h8 v40 h-8 z"/>

        <!-- Wood tip -->
        <path
            android:fillColor="#F5D6A0"
            android:pathData="M40,76 L54,92 L68,76 z"/>

        <!-- Graphite tip -->
        <path
            android:fillColor="#2B2B2B"
            android:pathData="M48,84 L54,92 L60,84 z"/>
    </group>
</vector>
